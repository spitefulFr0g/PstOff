#!/usr/bin/env bash
# Runs cargo with no network and no home directory, because crate build scripts
# and proc macros are third-party code. The repo is mounted read-only, so run
# `cargo fetch` first, outside the sandbox: it downloads crates and writes
# Cargo.lock without running crate code.
#
#   scripts/cargo-sandboxed test --workspace
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
sysroot=$(rustc --print sysroot)
cargo_home=${CARGO_HOME:-$HOME/.cargo}
target=${CARGO_TARGET_DIR:-$repo/target}
mkdir -p "$target"

args=(--unshare-all --die-with-parent --new-session
  --ro-bind /usr /usr --ro-bind /lib /lib --ro-bind /lib64 /lib64
  --ro-bind /etc/alternatives /etc/alternatives
  --proc /proc --dev /dev --tmpfs /tmp
  --ro-bind "$sysroot" /toolchain
  --ro-bind "$repo" "$repo" --bind "$target" "$target")
for dir in registry git; do
  if [[ -d $cargo_home/$dir ]]; then args+=(--ro-bind "$cargo_home/$dir" "/cargo/$dir"); fi
done

exec bwrap "${args[@]}" --clearenv \
  --setenv PATH /toolchain/bin:/usr/bin \
  --setenv CARGO_HOME /cargo \
  --setenv CARGO_NET_OFFLINE true \
  --setenv CARGO_TARGET_DIR "$target" \
  --setenv LD_LIBRARY_PATH /toolchain/lib \
  --setenv LANG C.UTF-8 \
  --chdir "$PWD" /toolchain/bin/cargo "$@"
