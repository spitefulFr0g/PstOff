#!/usr/bin/env bash
# Maintained Linux full checks. Dependencies must already be fetched.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
scripts/cargo-sandboxed metadata --locked --format-version 1 | python3 scripts/audit-dependencies.py
# Do not format/lint the preserved upstream fork, or run upstream fixture tests.
scripts/cargo-sandboxed fmt -p pstoff-engine -p pstoff-cli -p pstoff-gui -- --check
scripts/cargo-sandboxed clippy --locked -p pstoff-engine -p pstoff-cli -p pstoff-gui --all-targets -- -D warnings
scripts/cargo-sandboxed test --locked -p pstoff-engine -p pstoff-cli -p pstoff-gui
