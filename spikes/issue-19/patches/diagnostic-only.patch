+// DISPOSABLE DIAGNOSTIC ONLY: masks one column identity, never accepted output policy.
+fn diag_clear(mut blocks:Vec<Vec<u8>>, tag:u32)->Result<Vec<Vec<u8>>,String>{
+ let h=Heap::new(blocks.clone())?; let mut i=h.item(h.user_root)?.to_vec();
+ let u16b=|b:&[u8],o|u16::from_le_bytes(b[o..o+2].try_into().unwrap()) as usize;
+ let u32b=|b:&[u8],o|u32::from_le_bytes(b[o..o+4].try_into().unwrap());
+ let mut cols:Vec<_>=i[22..].chunks_exact(8).map(|c|c.to_vec()).collect();
+ assert!(!cols.iter().any(|c|u32b(c,0)>>16==(0x7000|(tag&0xfff))));
+ let mut found=false;
+ for c in &mut cols {if u32b(c,0)>>16==tag {c[2..4].copy_from_slice(&((0x7000|(tag&0xfff)) as u16).to_le_bytes());found=true;}}
+ if !found{return Ok(blocks)};
+ cols.sort_by_key(|c|u32b(c,0));for (n,c) in cols.iter().enumerate(){i[22+n*8..30+n*8].copy_from_slice(c);}
+ let hid=h.user_root;let bi=(hid>>16) as usize;let ai=((hid>>5)&0x7ff) as usize;
+ let map=u16b(&blocks[bi],0);let start=u16b(&blocks[bi],map+4+(ai-1)*2);
+ blocks[bi][start..start+i.len()].copy_from_slice(&i);
+ Ok(blocks)
+}
