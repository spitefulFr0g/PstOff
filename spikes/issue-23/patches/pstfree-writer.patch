+// Actual writer seam: preserve every existing allocation/HID and PC record byte;
+// append one allocation, insert one sorted property record. No general relocator.
+pub fn promote(mut blocks:Vec<Vec<u8>>, value:[u8;8])->Result<Vec<Vec<u8>>,String> {
+    let h=Heap::new(blocks.clone())?;
+    if h.client_sig!=0xbc { return Err("not PC".into()); }
+    let bh=h.item(h.user_root)?;
+    if bh.len()!=8 || bh[..4]!=[0xb5,2,6,0] { return Err("unsupported PC BTH".into()); }
+    let root=u32b(bh,4); let records=h.item(root)?;
+    if records.len()%8!=0 { return Err("PC record length".into()); }
+    if records.chunks_exact(8).any(|r|u16b(r,0)==0x3008) { return Ok(blocks); }
+    if u64::from_le_bytes(value)==0 || u64::from_le_bytes(value)>i64::MAX as u64 { return Err("unvalidated FILETIME".into()); }
+    let last=blocks.len()-1;
+    let count=u16b(&blocks[last],u16b(&blocks[last],0));
+    if count>=2047 { return Err("allocation index overflow".into()); }
+    let hid=((last as u32)<<16)|(((count+1) as u32)<<5);
+    let mut rs:Vec<Vec<u8>>=records.chunks_exact(8).map(|r|r.to_vec()).collect();
+    if rs.windows(2).any(|r|u16b(&r[0],0)>=u16b(&r[1],0)) { return Err("PC key order".into()); }
+    let mut record=vec![0x08,0x30,0x40,0]; record.extend(hid.to_le_bytes()); rs.push(record); rs.sort_by_key(|r|u16b(r,0));
+    let updated=rs.concat();
+    for (bi,b) in blocks.iter_mut().enumerate() {
+        let map=u16b(b,0); let count=u16b(b,map); let start=u16b(b,map+4);
+        let extra=usize::from(bi==last);
+        let mut out=b[..start].to_vec(); let mut offsets=Vec::new(); let mut free=0u16;
+        for ai in 1..=count+extra {
+            offsets.push(out.len() as u16);
+            let id=((bi as u32)<<16)|((ai as u32)<<5);
+            let v=if ai>count { &value[..] } else if id==root { &updated } else { h.item(id)? };
+            if v.is_empty(){free+=1;} out.extend(v);
+        }
+        offsets.push(out.len() as u16);
+        // HNPAGEMAP must be aligned even when the last allocation has odd length.
+        if out.len()%2!=0 { out.push(0); }
+        let map=out.len();
+        out.extend(((count+extra) as u16).to_le_bytes()); out.extend(free.to_le_bytes());
+        for x in offsets { out.extend(x.to_le_bytes()); }
+        if out.len()>8176 { return Err("Q12 expansion needs heap relocation".into()); }
+        out[..2].copy_from_slice(&(map as u16).to_le_bytes()); *b=out;
+    }
+    Ok(blocks)
+}
