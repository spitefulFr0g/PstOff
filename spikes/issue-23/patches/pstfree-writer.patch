+// PUBLIC fixture spike: Q12 source-cache observation, never server-history evidence.
+use crate::{ltp::{Heap, bth_records}, ndb::{Pst, Node}};
+use std::collections::BTreeMap;
+fn u16b(b: &[u8], i: usize) -> usize { u16::from_le_bytes(b[i..i+2].try_into().unwrap()) as usize }
+fn u32b(b: &[u8], i: usize) -> u32 { u32::from_le_bytes(b[i..i+4].try_into().unwrap()) }
+
+// A malformed relevant table prevents promotion, rather than hiding an occurrence.
+// Deliberately bounded to leaf row indexes and source row matrices in this fixture.
+pub fn observations(blocks: Vec<Vec<u8>>, external: Option<Vec<Vec<u8>>>) -> Result<Vec<(u32, Result<[u8;8], String>)>, String> {
+    let h = Heap::new(blocks)?;
+    if h.client_sig != 0x7c { return Err("not a TC".into()); }
+    let i = h.item(h.user_root)?;
+    if i.len()<22 || i[0]!=0x7c || i.len()!=22+i[1] as usize*8 { return Err("TC header length/signature".into()); }
+    let width=u16b(i,8); let ceb=u16b(i,6);
+    if width<4 || ceb<4 || ceb>=width { return Err("TC row dimensions".into()); }
+    let cols:Vec<_>=i[22..].chunks_exact(8).collect();
+    let ids:Vec<_>=cols.iter().filter(|c| u32b(c,0)>>16==0x67f2).collect();
+    if ids.len()!=1 || u32b(ids[0],0)!=0x67f20003 || u16b(ids[0],4)!=0 || ids[0][6]!=4 { return Err("row identity descriptor".into()); }
+    let idbit=ids[0][7] as usize;
+    if ceb+idbit/8>=width { return Err("row identity bit bounds".into()); }
+    let times:Vec<_>=cols.iter().filter(|c| u32b(c,0)>>16==0x3008).collect();
+    let bh=h.item(u32b(i,10))?;
+    if bh.len()!=8 || bh[..4]!=[0xb5,4,4,0] { return Err("unsupported row-index BTH".into()); }
+    let index=h.item(u32b(bh,4))?;
+    if index.len()%8!=0 { return Err("row-index length".into()); }
+    let rm=u32b(i,14);
+    let matrix=if rm&31!=0 { external.ok_or("missing row subnode")? } else { vec![h.item(rm)?.to_vec()] };
+    if matrix.iter().any(|b| b.len()%width!=0) { return Err("source row block padding unsupported".into()); }
+    let rows=matrix.concat();
+    if rows.len()%width!=0 || rows.len()/width!=index.len()/8 { return Err("row/index count or padding".into()); }
+    let mut seen=std::collections::HashSet::new();
+    let mut out=Vec::new();
+    for entry in index.chunks_exact(8) {
+        let nid=u32b(entry,0); let ix=u32b(entry,4) as usize;
+        if ix>=rows.len()/width || !seen.insert(ix) { return Err("row-index identity/duplicate".into()); }
+        let r=&rows[ix*width..(ix+1)*width];
+        if u32b(r,0)!=nid || r[ceb+idbit/8] & (0x80>>(idbit%8))==0 { return Err("row identity mismatch/absent".into()); }
+        let value=(|| {
+            if times.is_empty() { return Err("missing cache descriptor".into()); }
+            if times.len()!=1 { return Err("duplicate cache descriptor".into()); }
+            let c=times[0]; let off=u16b(c,4); let bit=c[7] as usize;
+            if u32b(c,0)!=0x30080040 || c[6]!=8 || off+8>ceb || ceb+bit/8>=width { return Err("invalid cache type/length/bounds".into()); }
+            if r[ceb+bit/8] & (0x80>>(bit%8))==0 { return Err("missing cache cell".into()); }
+            let v:[u8;8]=r[off..off+8].try_into().unwrap();
+            let n=u64::from_le_bytes(v);
+            // Zero/signed-high sentinel values are not validated usable FILETIMEs.
+            if n==0 || n>i64::MAX as u64 { return Err("invalid cache FILETIME".into()); }
+            Ok(v)
+        })();
+        out.push((nid,value));
+    }
+    Ok(out)
+}
+
+// Shared selection seam used by conversion and output-level policy guards.
+pub fn eligible(existing:bool, obs:&[Result<[u8;8],String>], tables_valid:bool)->(&'static str,Option<[u8;8]>) {
+    if existing { return ("preserved_existing",None); }
+    if !tables_valid { return ("unresolved_table_validation",None); }
+    if obs.is_empty() { return ("unresolved_missing_cache",None); }
+    if obs.iter().any(|v| match v { Err(_)=>true, Ok(b)=> {let n=u64::from_le_bytes(*b); n==0 || n>i64::MAX as u64} }) { return ("unresolved_invalid_or_missing_cache",None); }
+    if obs.iter().any(|v|v.as_ref().unwrap()!=obs[0].as_ref().unwrap()) { return ("unresolved_conflicting_cache",None); }
+    ("promoted_exact_same_nid_cache",Some(*obs[0].as_ref().unwrap()))
+}
+
+pub fn plan(pst:&mut Pst,nodes:&[Node])->Result<BTreeMap<u32,[u8;8]>,String> {
+    let mut all:BTreeMap<u32,Vec<(u32,Result<[u8;8],String>)>>=BTreeMap::new();
+    let mut table_errors=Vec::new();
+    for n in nodes.iter().filter(|n| matches!(n.nid_type(),14|15|16)) {
+        let read=(|| {
+            let blocks=pst.node_blocks(n.bid_data)?;
+            let h=Heap::new(blocks.clone())?;
+            let info=h.item(h.user_root)?;
+            if info.len()<22 { return Err("short TC header".into()); }
+            let rm=u32b(info,14);
+            let external=if rm&31!=0 {
+                let subs=pst.subnodes(n.bid_sub)?;
+                let sub=subs.get(&rm).ok_or("missing row subnode")?;
+                Some(pst.node_blocks(sub.data)?)
+            } else { None };
+            observations(blocks,external)
+        })();
+        match read {
+            Ok(rows)=>for (nid,v) in rows { all.entry(nid).or_default().push((n.nid,v)); },
+            Err(e)=>table_errors.push(format!("{:08x}:{}",n.nid,e)),
+        }
+    }
+    let mut result=BTreeMap::new();
+    for n in nodes.iter().filter(|n| matches!(n.nid_type(),4|8)) {
+        let h=Heap::new(pst.node_blocks(n.bid_data)?)?;
+        if h.client_sig!=0xbc { return Err("message not a PC".into()); }
+        let (key,rs)=bth_records(&h)?;
+        if key!=2 || rs.iter().any(|r| r.len()!=8) { return Err("invalid message PC records".into()); }
+        let existing=rs.iter().any(|r| u16b(r,0)==0x3008);
+        let obs=all.get(&n.nid).cloned().unwrap_or_default();
+        let refs=obs.iter().map(|(t,_)|format!("{:08x}",t)).collect::<Vec<_>>().join(",");
+        let values=obs.iter().map(|(_,v)|v.clone()).collect::<Vec<_>>();
+        let (reason,value)=eligible(existing,&values,table_errors.is_empty());
+        if let Some(v)=value { result.insert(n.nid,v); }
+        println!("Q12 nid={:08x} kind={} reason={} source_tables={} occurrences={}",n.nid,n.nid_type(),reason,refs,obs.len());
+    }
+    for e in table_errors { println!("Q12_TABLE unresolved={e}"); }
+    Ok(result)
+}
